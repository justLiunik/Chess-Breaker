{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkbreaker.dev/schemas/run.schema.json",
  "title": "RunState",
  "description": "Persistent state of one run: deck instances, coins, loadout, progress. Survives stages; saved to localStorage. See docs/09-technical-architecture.md §8.",
  "type": "object",
  "required": [
    "version", "seed", "actIndex", "stageIndex", "coins",
    "deckCapacity", "deck", "loadout", "history", "rngCursor", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Save-format version. Unknown future versions must be refused, not migrated silently."
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9A-F]{4}-[0-9A-F]{4}$",
      "description": "Run seed. Fully determines every generated board, enemy move, and shop stock."
    },
    "actIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
    "stageIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
    "coins": { "type": "integer", "minimum": 0 },
    "deckCapacity": {
      "type": "integer",
      "const": 8,
      "description": "Slots for non-king pieces: strictly 8, never raised (data/economy.yaml → deck.capacity). The king never occupies a slot."
    },
    "deck": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/pieceInstance" },
      "description": "Exactly one king must be present; at most deckCapacity + 1 entries."
    },
    "loadout": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/loadedSkill" }
    },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/stageRecord" }
    },
    "rngCursor": {
      "type": "integer",
      "minimum": 0,
      "description": "Explicit RNG position. Never a mutable PRNG object; keeps state serializable."
    },
    "status": { "enum": ["in_progress", "won", "lost"] }
  },
  "$defs": {
    "pieceInstance": {
      "type": "object",
      "description": "A Hero Piece: one deck-owned instance. See docs/06 §3–§4.",
      "required": [
        "instanceId", "pieceType", "rarity", "durability", "durabilityMax",
        "origin", "acquiredAtStage", "status"
      ],
      "additionalProperties": false,
      "properties": {
        "instanceId": { "type": "string", "pattern": "^p_[a-z0-9_]+$" },
        "pieceType": {
          "enum": ["king", "knight", "bishop", "rook", "queen"],
          "description": "No pawns: pawns are stage-only and never join the deck (docs/06 §4.2)."
        },
        "rarity": {
          "enum": ["normal", "rare", "unique", "legendary", null],
          "description": "Fixed at creation. null = the King only, which has no rarity (invariant I12). Order is data/economy.yaml → rarity.tiers."
        },
        "durability": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Remaining deployments. null = immortal (king only)."
        },
        "durabilityMax": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "null = immortal (king only). Depends on rarity for some types (pieces.yaml → durabilityMaxByRarity)."
        },
        "origin": {
          "enum": ["starter", "shop", "promotion", "merge", "reward"],
          "description": "promotion = created when a spawned pawn reached rank 8 (docs/02 §2.2); merge = created from 3 identical pieces (docs/06 §5)."
        },
        "acquiredAtStage": { "type": "integer", "minimum": 0 },
        "usedOnce": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["lifeline"] },
          "description": "Once-per-run rarity abilities this instance has already used (docs/02 §2.3). Omitted = none used."
        },
        "status": { "enum": ["in_deck", "deployed", "captured", "spent"] }
      },
      "allOf": [
        {
          "$comment": "Invariant I12: the King has no rarity; every other piece has exactly one tier.",
          "if": { "properties": { "pieceType": { "const": "king" } }, "required": ["pieceType"] },
          "then": { "properties": { "rarity": { "const": null } } },
          "else": { "properties": { "rarity": { "type": "string" } } }
        }
      ]
    },
    "loadedSkill": {
      "type": "object",
      "required": ["skillId", "charges", "chargesMax"],
      "additionalProperties": false,
      "properties": {
        "skillId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "charges": { "type": "integer", "minimum": 0 },
        "chargesMax": { "type": "integer", "minimum": 1 }
      }
    },
    "stageRecord": {
      "type": "object",
      "required": [
        "stageSeed", "templateId", "outcome", "turnsUsed", "coinsEarned", "piecesLost"
      ],
      "additionalProperties": false,
      "properties": {
        "stageSeed": { "type": "string", "pattern": "^[0-9A-F]{4}-[0-9A-F]{4}$" },
        "templateId": { "type": "string", "pattern": "^tpl-[a-z0-9-]+$" },
        "outcome": { "enum": ["win", "loss"] },
        "turnsUsed": { "type": "integer", "minimum": 1 },
        "coinsEarned": { "type": "integer", "minimum": 0 },
        "piecesLost": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "$comment": "Invariant I1: the deck contains exactly one king. Capacity (I9) is a semantic check in scripts/validate-content.mjs, not expressible here because it depends on deckCapacity.",
      "properties": {
        "deck": {
          "contains": {
            "properties": { "pieceType": { "const": "king" } },
            "required": ["pieceType"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ]
}
