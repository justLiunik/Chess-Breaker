{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkbreaker.dev/schemas/template.schema.json",
  "title": "StageTemplate",
  "description": "A designed encounter skeleton. Templates fix difficulty shape and randomization ranges; they never specify the player's deck army (that comes from the deck) or any rarity. Enemy squares are generated, except in a placement: fixed template, which hand-places the enemy army for set-piece stages. See docs/04-stage-generation-and-authoring.md.",
  "type": "object",
  "required": [
    "id", "title", "act", "tier", "turnLimit",
    "openingPlacements", "spawnedPawns", "deploymentRanks",
    "deploymentsPerTurn", "focusPool", "enemyPolicy", "preconditions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^tpl-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "act": { "type": "integer", "minimum": 1, "maximum": 3 },
    "tier": { "enum": ["normal", "boss"] },
    "turnLimit": { "type": "integer", "minimum": 1, "maximum": 20 },
    "openingPlacements": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Pieces drawn from the deck for the free opening line, King always included."
    },
    "enemyArmy": {
      "type": "object",
      "description": "Inclusive [min,max] counts per enemy piece type, excluding the king (always exactly 1).",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "pawn": { "$ref": "#/$defs/range" },
        "knight": { "$ref": "#/$defs/range" },
        "bishop": { "$ref": "#/$defs/range" },
        "rook": { "$ref": "#/$defs/range" },
        "queen": { "$ref": "#/$defs/range" }
      }
    },
    "placement": {
      "enum": ["generated", "fixed"],
      "default": "generated",
      "description": "generated: enemyArmy is rolled and placed in enemyZone. fixed: fixedEnemy gives every enemy square by hand (tutorial and set-piece stages); the solver still validates it against the player's actual deck (docs/04 §2)."
    },
    "fixedEnemy": {
      "type": "object",
      "description": "placement: fixed only. Every enemy piece, king included, by square.",
      "minProperties": 2,
      "patternProperties": {
        "^[a-h][1-8]$": { "enum": ["king", "pawn", "knight", "bishop", "rook", "queen"] }
      },
      "additionalProperties": false
    },
    "enemyZone": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 8 },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Ranks the enemy army may occupy."
    },
    "spawnedPawns": {
      "type": "object",
      "required": ["count", "ranks"],
      "additionalProperties": false,
      "description": "Free, stage-only pawns spawned for the player (docs/02 §2.2). Rarity comes from data/economy.yaml → rarity.pool, never from the template.",
      "properties": {
        "count": {
          "$ref": "#/$defs/range",
          "description": "Inclusive [min,max] number of spawned pawns. min must be >= 1."
        },
        "ranks": {
          "type": "array",
          "items": { "type": "integer", "minimum": 2, "maximum": 7 },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Ranks the pawns may spawn on. Must not overlap enemyZone, and rank 8 must be reachable within the turn limit."
        }
      }
    },
    "deploymentRanks": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 8 },
      "minItems": 1,
      "uniqueItems": true
    },
    "deploymentsPerTurn": { "type": "integer", "minimum": 0, "maximum": 3 },
    "focusPool": { "type": "integer", "minimum": 1, "maximum": 9 },
    "enemyPolicy": { "$ref": "#/$defs/enemyPolicy" },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "king_on_board",
          "no_precheck",
          "no_immediate_mate",
          "deployment_squares_available",
          "enemy_value_in_band",
          "spawned_pawns_placed"
        ]
      }
    },
    "designNote": {
      "type": "string",
      "description": "What this template is meant to teach or test."
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 8 },
      "minItems": 2,
      "maxItems": 2
    },
    "enemyPolicy": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["best_move", "scripted"] },
        "depth": { "type": "integer", "minimum": 1, "maximum": 6 },
        "seed": { "type": "string" },
        "line": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-h][1-8][a-h][1-8]$" },
          "description": "Required when type is 'scripted'. Enemy moves as from+to squares, e.g. 'e8e7'."
        },
        "fallbackDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "best_move depth used once a scripted line breaks or runs out (docs/02 §8.1). Defaults to enemyAI.search.defaultFallbackDepth."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "scripted" } }, "required": ["type"] },
          "then": { "required": ["line"] }
        }
      ]
    }
  },
  "allOf": [
    {
      "$comment": "Generated templates roll and place their enemy; fixed templates hand-place it.",
      "if": { "properties": { "placement": { "const": "fixed" } }, "required": ["placement"] },
      "then": {
        "required": ["fixedEnemy"],
        "not": { "anyOf": [{ "required": ["enemyArmy"] }, { "required": ["enemyZone"] }] }
      },
      "else": {
        "required": ["enemyArmy", "enemyZone"],
        "not": { "required": ["fixedEnemy"] }
      }
    }
  ]
}
