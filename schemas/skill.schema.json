{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkbreaker.dev/schemas/skill.schema.json",
  "title": "SkillDefinition",
  "description": "A rule-breaking skill expressed as data. Adding a skill must never require engine changes. See docs/03-skill-framework.md.",
  "type": "object",
  "required": [
    "id", "name", "category", "ruleBroken", "text",
    "trigger", "cost", "charges", "price", "target", "effects", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "category": {
      "enum": [
        "action_economy",
        "transformation",
        "status",
        "movement_override",
        "board_manipulation",
        "information_planning",
        "resource"
      ]
    },
    "ruleBroken": {
      "type": "string",
      "minLength": 3,
      "description": "Exactly one sentence naming the specific chess rule this violates. Pillar 3."
    },
    "text": { "type": "string", "minLength": 3, "description": "Player-facing card text." },
    "trigger": { "enum": ["activate", "passive", "reaction"] },
    "cost": {
      "type": "integer",
      "minimum": 0,
      "description": "Focus cost. Focus never buys move credits; only skills do that."
    },
    "charges": {
      "type": "integer",
      "minimum": 1,
      "description": "Activations per STAGE. Refreshes at every stage start."
    },
    "price": {
      "type": "integer",
      "minimum": 1,
      "description": "Act I shop price in coins. Later acts apply economy.yaml priceInflationPerAct, as pieces do; a duplicate purchase (+1 charge) costs skills.duplicatePurchase.priceMultiplier of it (docs/07 §2)."
    },
    "target": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["none", "own_piece", "enemy_piece", "board_square"] },
        "pieceType": { "enum": ["king", "pawn", "knight", "bishop", "rook", "queen"] },
        "must_be_on_board": { "type": "boolean" },
        "excludes": {
          "type": "array",
          "items": { "enum": ["king", "pawn", "knight", "bishop", "rook", "queen"] }
        },
        "excludesRarity": {
          "type": "array",
          "uniqueItems": true,
          "description": "Rarity tiers that cannot be targeted, e.g. Ascension excludes a Legendary bishop, which already moves like a queen (docs/03 §5).",
          "items": { "enum": ["normal", "rare", "unique", "legendary"] }
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["primitive", "duration"],
        "additionalProperties": false,
        "properties": {
          "primitive": {
            "enum": [
              "grant_move_credit",
              "grant_focus",
              "set_piece_type",
              "override_moveset",
              "ignore_blockers",
              "suppress_piece",
              "shield_king",
              "remove_piece",
              "place_piece",
              "displace_piece",
              "return_to_deck",
              "shield_piece",
              "reveal_intent",
              "add_plan_undo"
            ]
          },
          "params": { "type": "object" },
          "duration": { "enum": ["instant", "this_turn", "next_enemy_turn", "permanent"] }
        }
      }
    },
    "restrictions": {
      "type": "array",
      "items": {
        "enum": ["once_per_turn", "distinct_targets", "requires_bishop_on_board"]
      }
    },
    "status": { "enum": ["mvp", "future"] }
  }
}
